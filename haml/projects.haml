!!! 5
%html{lang: "en"}
%head
    - require_relative 'data.rb'
    %meta{charset: "UTF-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1.0"}
    %title= $title[:projects]
    -# %link{rel:"stylesheet", href:"https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=home,music_note,science"}
    %link{rel:"stylesheet", href:"css/main.css"}
%body
    %nav
        %a{href:"index.html"}= $me[:name]
        = ": "
        %ul
            - $nav.each do |nav|
                %li
                    %a.material-symbols-rounded{href:"#{nav[:link]}.html"}= nav[:text]
                    = "|" unless nav == $nav.last
    .z-wrapper
        .foreground
            - $contents.each do |content|
                .post.box
                    .codename
                        %a{href:"#{content[:date_link]}.html"}
                            = content[:codename]
                    .fullname= content[:code_expl]
                    %h1= content[:title]
                    .img-box.box
                        %img.proj-ill{src: "#{content[:date_link]}.png", alt: "#{content[:img_alt]}"}
                    .date
                        %h3= content[:date]
                    .post-desc-box.box= content[:post_desc]
        .noise-bg.bg
            .white-bg
            .yellow-bg
            .black-bg
        .grad-bg.bg
            .white-bg 
            .yellow-bg
            .black-bg
        .scroll-bg.bg
        -#.grid
            - 100.times do |i|
                .grid-row
                    - 100.times do |j|
                        .grid-item= "#{i}, #{j}"